<?xml version="1.0" encoding="utf-8"?>
<!-- Place with no photo: coffee category cover (gradient + white icon). Sized so it scales well
     as the detail page cover, a Popular card and a round Nearest thumbnail. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="400dp" android:height="360dp">
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#8D5B4C" android:endColor="#D4A373" />
        </shape>
    </item>
    <item android:width="96dp" android:height="96dp" android:gravity="center"
        android:drawable="@drawable/ic_cat_coffee" />
</layer-list>
