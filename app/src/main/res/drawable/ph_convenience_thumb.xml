<?xml version="1.0" encoding="utf-8"?>
<!-- Round-thumbnail version of ph_convenience: same gradient, bigger icon for small sizes -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="96dp" android:height="96dp">
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#5B4FC7" android:endColor="#8E9BFF" />
        </shape>
    </item>
    <item android:width="48dp" android:height="48dp" android:gravity="center"
        android:drawable="@drawable/ic_cat_convenience" />
</layer-list>
