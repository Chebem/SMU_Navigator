<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="80dp"
    android:clipToPadding="false"
    android:background="@drawable/main_bg_gradient2">

    <!-- Back (only when editing an existing profile; first-time setup can't be skipped).
         Translated out of the 80dp padding into the top-left corner. -->
    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/back3"
        android:contentDescription="@string/back"
        android:translationX="-64dp"
        android:translationY="-56dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Profile Image Selection -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/profileImage"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/ic_add_photo"
        android:contentDescription="@string/profile_image"
        app:civ_border_width="2dp"
        app:civ_border_color="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/selectImageHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tap_to_select_profile_image"
        android:textColor="@color/background_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/profileImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Name Input -->

    <!-- Department Input -->

    <!-- Bio Input -->

    <!-- Save Button -->

    <EditText
        android:id="@+id/nameInput"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="72dp"
        android:autofillHints=""
        android:background="@drawable/gradient_corner_bg"
        android:hint="@string/enter_your_name"
        android:inputType="textPersonName"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="#cccccc"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/selectImageHint" />

    <EditText
        android:id="@+id/departmentInput"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:autofillHints=""
        android:background="@drawable/gradient_corner_bg"
        android:hint="@string/enter_your_department"
        android:inputType="text|textNoSuggestions"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="#cccccc"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nameInput" />

    <EditText
        android:id="@+id/bioInput"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="40dp"
        android:autofillHints=""
        android:background="@drawable/gradient_corner_bg"
        android:gravity="top|start"
        android:hint="@string/write_a_short_bio"
        android:inputType="textMultiLine"
        android:maxLines="5"
        android:padding="14dp"
        android:textColor="@color/background_dark"
        android:textColorHint="#cccccc"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/departmentInput" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/saveProfileBtn"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:background="@drawable/rounded_button2"
        android:textColor="@color/white"
        android:text="@string/save_profile"
        android:textSize="22sp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:padding="4dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginStart="36dp"
        style="@android:style/Widget.Button"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@+id/bioInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>