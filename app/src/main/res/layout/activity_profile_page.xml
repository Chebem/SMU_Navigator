<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/main_bg_gradient2">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.ProfilePageActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/main_bg_gradient2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/main_bg_gradient2"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile Image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profileImg"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:background="@drawable/gradient_corner_bg"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/roundedCorner"
                app:strokeColor="@color/blue_dark"
                app:strokeWidth="2dp"
                android:padding="1dp"
                tools:srcCompat="@tools:sample/avatars" />

            <!-- Name -->
            <TextView
                android:id="@+id/nameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                tools:text="@string/michael_mabinuola"
                android:textAlignment="center"
                android:textColor="@color/blue_dark"
                android:textSize="25sp"
                android:textStyle="bold" />

            <!-- Department -->
            <TextView
                android:id="@+id/departmentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="@string/department_of_computer_science"
                android:textAlignment="center"
                android:textColor="@color/gray_dark"
                android:textSize="16sp" />

            <!-- About -->
            <TextView
                android:id="@+id/aboutText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                tools:text="@string/about"
                android:textAlignment="center"
                android:textColor="@color/blue_dark"
                android:textSize="16sp" />

            <!-- Divider -->

            <!-- Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/messageBtn"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/stroke_grey_bg"
                    android:padding="12dp"
                    app:srcCompat="@drawable/message" />

                <Button
                    android:id="@+id/followBtn"
                    android:layout_width="170dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/blue_bg"
                    android:gravity="center"
                    style="@android:style/Widget.Button"
                    android:text="@string/follow"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/shareBtn"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/stroke_grey_bg"
                    android:padding="12dp"
                    app:srcCompat="@drawable/share" />
            </LinearLayout>


            <!-- Stats Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="32dp"
                android:orientation="horizontal">

                <!-- Column 1 -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.333"
                    android:id="@+id/followersColumn"
                    android:background="?attr/selectableItemBackground"
                    android:paddingVertical="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/followersTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAlignment="center"
                        android:textColor="@color/blue_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/followers"
                        android:textAlignment="center"
                        android:textColor="@color/gray_dark"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- Column 2 -->
                <View
                    android:id="@+id/view5"
                    android:layout_width="1dp"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.333"
                    android:id="@+id/followingColumn"
                    android:background="?attr/selectableItemBackground"
                    android:paddingVertical="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/followingTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAlignment="center"
                        android:textColor="@color/blue_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/followings"
                        android:textAlignment="center"
                        android:textColor="@color/gray_dark"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Column 3 -->
                <View
                    android:id="@+id/view4"
                    android:layout_width="1dp"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.333"
                    android:paddingVertical="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/postsCountTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAlignment="center"
                        android:textColor="@color/blue_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/posts"
                        android:textAlignment="center"
                        android:textColor="@color/gray_dark"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->


            <View
                android:id="@+id/view6"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:background="@drawable/main_bg_gradient2" />


            <TextView
                android:id="@+id/posts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/posts"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:textColor="@color/blue_dark"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/postList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:nestedScrollingEnabled="false"
                android:orientation="vertical"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading screen: covers the profile until its data arrives, so no placeholder text shows -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/main_bg_gradient2"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center" />
    </FrameLayout>


    <com.ismaeldivita.chipnavigation.ChipNavigationBar
        android:id="@+id/navigationBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/stroke_white_bg"
        android:elevation="12dp"
        android:padding="0dp"
        app:cnb_iconColor="@color/blue_dark"
        app:cnb_iconSize="24dp"
        app:cnb_menuResource="@menu/menu_bottom"
        app:cnb_orientationMode="horizontal"
        app:cnb_radius="100dp"
        app:cnb_unselectedColor="@color/blue_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/settingsIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="16dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:src="@drawable/settings"
        app:tint="@color/blue_dark"
        android:contentDescription="@string/settings"
        android:background="?selectableItemBackgroundBorderless"
        android:scaleType="centerInside"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- Back: only on someone else's profile, returns to where you came from -->
    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:padding="16dp"
        android:src="@drawable/back3"
        android:contentDescription="@string/back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>
