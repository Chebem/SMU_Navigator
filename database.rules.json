{
  "rules": {
    // Any other top-level node (placesEn, Notices, Category, dormitoriesEn, ...) is
    // readable by signed-in users and never writable from the app.
    // Edit that content in the Firebase console, which bypasses these rules.
    "$node": {
      ".read": "auth != null",
      ".write": false
    },

    "profiles": {
      // Whole node is read for the social feed (MainActivity.initSocialFeed)
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        // Following someone: you may add or remove only your own entry in their followers list
        "followers": {
          "$followerUid": {
            ".write": "auth != null && auth.uid === $followerUid"
          }
        }
      }
    },

    "favorites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    }
  }
}
